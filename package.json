{
  "name": "aicustomer",
  "version": "1.0.0",
  "private": true,
  "description": "AI顧客相談・電話受付システム（テキスト / 音声 / 電話）デモ",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "learn:site": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/learn-website.mjs",
    "knowledge:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-resolve.mjs scripts/build-knowledge.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "next": "15.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
