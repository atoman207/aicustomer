# 一畳屋 AI相談窓口 の環境変数（必要なものだけ）
# このファイルを .env にコピーして値を入れてください。Vercel では Settings › Environment Variables に同じ内容を設定します（変更後は Redeploy で反映）
# 電話（Twilio）・スプレッドシート連携・独自ドメインを使うときに追加する変数は README の「2. 環境変数」を参照

# OpenAI の API キー（文字・声・電話の AI 応答。未設定の場合はデモモードで動作）
OPENAI_API_KEY=

# 使用するモデル
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Supabase（ナレッジ・アップロードしたファイル・会話履歴・受付・設定の保存先。secret キーはサーバー専用）
# Project Settings › API Keys の「secret」キー。テーブルは管理画面の「セットアップ」の SQL（supabase/schema.sql）で作成
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 管理画面のパスワード（受付一覧＝お客様の氏名・住所・電話番号を保護。公開 URL では必須）
ADMIN_PASSWORD=
