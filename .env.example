# ===== OpenAI（必須：AI応答・音声・要約。未設定でもデモモードで動作します） =====
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 互換API／プロキシを使う場合のみ（通常は空のまま）
# OPENAI_BASE_URL=https://api.openai.com/v1

# ===== 会社情報 =====
COMPANY_NAME=熊本たたみ工房（デモ）
COMPANY_PHONE=0120-000-000
NEXT_PUBLIC_COMPANY_NAME=熊本たたみ工房（デモ）
NEXT_PUBLIC_COMPANY_PHONE=0120-000-000
# 公開URL（Twilio/LINE の Webhook 署名検証・OGP に使用。例: https://your-app.vercel.app）
PUBLIC_BASE_URL=

# ===== データの永続化（Vercel 推奨：Storage › Upstash Redis を追加すると自動で設定されます） =====
# 未設定の場合、サーバーレス環境では受付・会話・設定が一時保存（再デプロイで消える）になります
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 旧 Vercel KV の変数名（KV_REST_API_URL / KV_REST_API_TOKEN）にも対応

# ===== ナレッジ（Googleスプレッドシート「社内総合マニュアル」の指定1シート） =====
# 方法A: GAS Webアプリ（gas/Code.gs をデプロイしたURL）※読み書き両対応・推奨
GAS_WEBHOOK_URL=
# 方法B: サービスアカウントでSheets APIを直接利用
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
KNOWLEDGE_SHEET_ID=
KNOWLEDGE_SHEET_NAME=AI回答用
# 方法C: 「ウェブに公開」したCSVのURL（読み取り専用）
KNOWLEDGE_SHEET_CSV_URL=
# キャッシュ秒数（シート更新の反映間隔）
KNOWLEDGE_CACHE_SECONDS=60

# ===== 受付情報の記録先（スプレッドシート） =====
RECEPTION_SHEET_ID=
RECEPTION_SHEET_NAME=受付一覧

# ===== Twilio（AI電話受付：0120番号からの転送先として利用） =====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TTS_VOICE=Polly.Mizuki
STAFF_FORWARD_NUMBER=

# ===== LINE Messaging API =====
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
NEXT_PUBLIC_LINE_ADD_FRIEND_URL=

# ===== 管理画面 =====
# 公開URLでは必ず設定してください。未設定の場合、管理画面はパスワードなしで開けます（デモ用）
ADMIN_PASSWORD=
