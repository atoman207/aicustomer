# 一畳屋 AI相談窓口 の環境変数（必要なものだけ）
# このファイルを .env にコピーして値を入れてください。Vercel では Settings › Environment Variables に同じ内容を設定します（変更後は Redeploy で反映）
# 電話（Twilio）・LINE・独自ドメインを使うときに追加する変数は README の「2. 環境変数」を参照

# OpenAI の API キー（文字・声・電話の AI 応答。未設定の場合はデモモードで動作）
OPENAI_API_KEY=

# 使用するモデル（README §3.5）
# 見積の聞き取り・要約など
OPENAI_CHAT_MODEL=gpt-4.1-mini
# お客様の質問に、指定のスプレッドシートの全文を読んで答えるモデル（最上位。推論は none＝すぐ答える）
OPENAI_ANSWER_MODEL=gpt-5.6-sol
OPENAI_ANSWER_REASONING=none
# 声の相談（話す AI・聞き取り＝文字起こし・話し終わりの判定・AI の声＝20代の女性の声 sage）
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_REALTIME_TURN=semantic
OPENAI_REALTIME_VOICE=sage
# 声の話す速さ（1＝標準。sage は 1.1 でふつうの会話の速さ）と、話す前に考える深さ（minimal＝すぐ話す）
OPENAI_REALTIME_SPEED=1.1
OPENAI_REALTIME_REASONING=minimal
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=sage
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 管理画面のパスワード（受付一覧＝お客様の氏名・住所・電話番号を保護。公開 URL では必須）
ADMIN_PASSWORD=

# AI の回答の情報源・受付の記録先になる Googleスプレッドシート
#   サービスアカウントの鍵（JSON）の client_email と private_key。鍵のファイルはリポジトリに置かないこと
#   private_key は改行を \n にした 1 行（-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n）。囲む " は不要
#   Vercel の値欄にも、この 1 行の = より後ろをそのまま貼る（" で囲んでも・改行のある形で貼っても読み取れます）
#   スプレッドシートの「共有」にサービスアカウントを「編集者」として追加（受付を「受付一覧」タブに記録するため）
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# スプレッドシートの ID（URL の /d/ と /edit の間）と、回答に使うタブの gid（URL の #gid= の数字）
KNOWLEDGE_SHEET_ID=
KNOWLEDGE_SHEET_GID=0
# 回答の根拠は指定のスプレッドシートだけ（ホームページは使わない）。AI が毎回スプレッドシートの全文を読んで答える
# 以前に AI が作った回答を同じ質問に再利用するときだけ 1（既定は再利用しない＝回答の精度を優先）
# ANSWER_REUSE=1

# 今のホームページの「AIに相談」の窓（public/embed.js）として開いてよいサイト（空白区切り。未設定なら下の 2 つ）
# ビルド時に読むので、変えたら Redeploy
# EMBED_ALLOWED_ORIGINS=https://ichijoya.co.jp https://www.ichijoya.co.jp
